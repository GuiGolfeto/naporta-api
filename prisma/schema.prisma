// Prisma schema — naPorta API
//
// Configuração da conexão (datasource url / migrations / seed) fica em
// `prisma.config.ts`, conforme a convenção do Prisma 7.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  // Imports com extensão `.ts`: o `tsc` reescreve para `.js` no build
  // (rewriteRelativeImportExtensions) e o `tsx` (seed) resolve direto.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Papel do usuário na API.
enum Role {
  /// Usuário comum: gerencia apenas os próprios pedidos.
  USER
  /// Administrador: gerencia todos os pedidos.
  ADMIN
}

/// Situação do pedido no fluxo de entrega.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Usuário da API.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(180)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  orders        Order[]
  refreshTokens RefreshToken[]

  @@index([deletedAt])
  @@map("users")
}

/// Refresh token rotativo e revogável.
///
/// Armazena apenas o hash do token: o valor original nunca é persistido.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Pedido de entrega.
model Order {
  id       String      @id @default(uuid()) @db.Uuid
  /// Identificador de negócio exibido ao cliente. Ex.: `NP-2026-00001`.
  /// Único globalmente — o número nunca é reutilizado, nem após soft delete.
  number               String      @unique @db.VarChar(20)
  status               OrderStatus @default(PENDING)
  expectedDeliveryDate DateTime    @map("expected_delivery_date") @db.Date
  customerName         String      @map("customer_name") @db.VarChar(120)
  /// Documento do cliente (CPF ou CNPJ), apenas dígitos.
  customerDocument     String      @map("customer_document") @db.VarChar(20)
  /// Total desnormalizado (soma dos itens) para listagem sem JOIN.
  total       Decimal @db.Decimal(12, 2)
  createdById String  @map("created_by_id") @db.Uuid
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  address Address?
  items   OrderItem[]

  @@index([status])
  @@index([expectedDeliveryDate])
  @@index([createdById])
  @@index([deletedAt])
  @@map("orders")
}

/// Endereço de entrega (relação 1:1 com o pedido).
model Address {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @unique @map("order_id") @db.Uuid
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  street       String   @db.VarChar(150)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(80)
  neighborhood String   @db.VarChar(80)
  city         String   @db.VarChar(80)
  /// Sigla da unidade federativa (2 letras).
  state String @db.Char(2)
  /// CEP do endereço de entrega.
  zipCode String  @map("zip_code") @db.VarChar(10)
  country String @default("BR") @db.Char(2)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("addresses")
}

/// Item do pedido.
model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String   @db.VarChar(200)
  quantity    Int      @default(1)
  /// Preço unitário.
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  /// Preço unitário multiplicado pela quantidade.
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([orderId])
  @@map("order_items")
}

/// Contador anual de pedidos, usado para gerar o número sequencial do pedido.
model OrderCounter {
  /// Ano do contador (ex.: 2026).
  year       Int @id
  /// Último número sequencial usado no ano.
  lastNumber Int @map("last_number")

  @@map("order_counters")
}

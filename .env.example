# =============================================================================
# naPorta API — variáveis de ambiente
# Copie para `.env` (ajuste os valores) e rode a API.
# NUNCA versione o `.env` real — apenas este arquivo de exemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Credenciais do banco (usadas pelo docker-compose)
POSTGRES_USER=naporta
POSTGRES_PASSWORD=naporta_dev_password
POSTGRES_DB=naporta
POSTGRES_TEST_PASSWORD=naporta_test_password
POSTGRES_TEST_DB=naporta_test
# Portas expostas no host (use se a porta padrão estiver ocupada na sua máquina)
DB_HOST_PORT=5432
DB_TEST_HOST_PORT=5433
# Porta da API exposta no host (docker compose)
API_HOST_PORT=3000
# Banco de desenvolvimento (docker-compose: serviço `db`)
DATABASE_URL=postgresql://naporta:naporta_dev_password@localhost:5432/naporta
# Banco de testes e2e (docker-compose: serviço `db-test`)
DATABASE_URL_TEST=postgresql://naporta:naporta_test_password@localhost:5433/naporta_test
# -----------------------------------------------------------------------------
# Autenticação (Módulo 2)
# Segredos de desenvolvimento abaixo NÃO podem ser usados em produção.
# Mínimo de 32 caracteres. Em produção, defina segredos próprios e distintos.
# -----------------------------------------------------------------------------
JWT_SECRET=dev-only-access-secret-change-me-0123456789
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
# Origens permitidas (separadas por vírgula). Use `*` apenas em dev.
# O portal (localhost:3001) também precisa estar na lista: ele fala com a API
# a partir do browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Quantos proxies à frente da API são confiáveis para o IP do cliente.
# 0 = seguro por padrão (não confiar em X-Forwarded-For); 1 = há nginx à frente.
TRUST_PROXY=0
# Rate limit global (requisições por janela, em ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Rate limit das rotas de credencial (/auth/login, /auth/register, /auth/refresh)
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=5

# -----------------------------------------------------------------------------
# Portal web (apps/web)
# -----------------------------------------------------------------------------
# URL da API usada pelo servidor do portal (Server Components e Actions).
# No Docker Compose é o serviço `api`; localmente, a API da máquina.
API_URL=http://localhost:3000/api/v1
# URL da API usada pelo browser — é embutida no bundle do Next (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Porta do portal exposta no host (docker compose)
WEB_HOST_PORT=3001

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
# `pretty` = log legível (desenvolvimento) | `json` = estruturado (produção)
LOG_FORMAT=pretty
# Formato do log **dentro do container** (o Compose sempre usa JSON)
CONTAINER_LOG_FORMAT=json

{
  "name": "naporta-api",
  "version": "0.1.0",
  "description": "Web API para a naPorta — gestão de pedidos de entrega",
  "author": "naPorta",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:cov": "vitest run --config vitest.e2e.config.ts --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "joi": "18.3.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}

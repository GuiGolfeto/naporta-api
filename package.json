{
  "name": "naporta",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo da naPorta — API (NestJS) e portal web (Next.js)",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @naporta/api",
    "dev:web": "npm run dev --workspace @naporta/web",
    "build": "npm run build --workspace @naporta/contracts && npm run build --workspace @naporta/api && npm run build --workspace @naporta/web",
    "build:api": "npm run build --workspace @naporta/api",
    "build:web": "npm run build --workspace @naporta/web",
    "start:api": "npm run start:prod --workspace @naporta/api",
    "start:web": "npm run start --workspace @naporta/web",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md,yml,yaml,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @naporta/api",
    "test:api": "npm run test --workspace @naporta/api",
    "test:e2e": "npm run test:e2e --workspace @naporta/api",
    "test:e2e:web": "npm run test:e2e --workspace @naporta/web",
    "test:all": "npm run test --workspace @naporta/api && npm run test:e2e --workspace @naporta/api && npm run test:e2e --workspace @naporta/web",
    "test:cov": "npm run test:cov --workspace @naporta/api",
    "test:e2e:cov": "npm run test:e2e:cov --workspace @naporta/api",
    "seed": "npm run seed --workspace @naporta/api",
    "prisma:generate": "npm run prisma:generate --workspace @naporta/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @naporta/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @naporta/api",
    "prisma:studio": "npm run prisma:studio --workspace @naporta/api",
    "seed:api": "npm run seed:api --workspace @naporta/api",
    "db:reset": "npm run db:reset --workspace @naporta/api",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api web",
    "docs:pdf": "cd docs && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-sandbox --no-pdf-header-footer --print-to-pdf=\"documento-tecnico.pdf\" --virtual-time-budget=8000 \"file://$PWD/documento-tecnico.html\" && cd .. && python3 docs/pdf-footer.py docs/documento-tecnico.pdf",
    "build:contracts": "npm run build --workspace @naporta/contracts"
  }
}
